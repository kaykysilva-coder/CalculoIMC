<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.calculoimc.controller.MainController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <!-- Formulario e Resultado do IMC -->
    <HBox spacing="20.0">
        <!-- Campos de entrada -->
        <VBox prefWidth="300.0" spacing="10.0">
            <Label text="Nome:" />
            <TextField fx:id="txtNome" />

            <Label text="Altura (m):" />
            <TextField fx:id="txtAltura" promptText="Ex: 1.75" />

            <Label text="Peso (kg):" />
            <TextField fx:id="txtPeso" promptText="Ex: 70.5" />
        </VBox>

        <!-- Display do Resultado -->
        <VBox alignment="CENTER" prefWidth="200.0" spacing="5.0">
            <Label text="Cálculo IMC">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label fx:id="lblResultadoIMC" text="0.00">
                <font>
                    <Font size="48.0" />
                </font>
            </Label>
        </VBox>
    </HBox>

    <!-- Botoes de Acao -->
    <HBox spacing="10.0">
        <Button onAction="#onCalcularClick" text="Calcular IMC" />
        <Button onAction="#onSalvarClick" text="Salvar" />
        <Button onAction="#onCarregarClick" text="Carregar Dados" />
    </HBox>

    <!-- Tabela de Dados Unica -->
    <TableView fx:id="tablePessoas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNome" prefWidth="200.0" text="NOME" />
            <TableColumn fx:id="colAltura" prefWidth="100.0" text="ALTURA" />
            <TableColumn fx:id="colImc" prefWidth="100.0" text="IMC" />
        </columns>
    </TableView>
</VBox>